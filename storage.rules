rules_version = '2';

// Deploy with: firebase deploy --only storage
// (requires the Firebase CLI and `firebase init` once, pointed at this
// project — same setup as firestore.rules)
//
// New submission photos no longer upload here as of this version — they
// go to Cloudinary instead (see src/services/cloudinaryPhotoService.ts
// and functions/src/index.ts's mintCloudinaryUploadSignature, and that
// file's header comment for why: this bucket's free tier is a flat 5GB,
// and Cloudinary's is far more generous on both storage and the
// repeated-viewing bandwidth these photos actually cost). This file and
// everything already sitting in this bucket keep working exactly as
// before — nothing here needed to change, and nothing already stored
// needs migrating; this is purely a going-forward switch for new photos.
//
// Layout: submissions/{uid}/{fileName} — one folder per uploader. A
// signed-in user can only ever write into their own folder, because
// {uid} is checked against request.auth.uid, which the client can't
// spoof (it's set by Firebase Auth, not sent by the browser). Read is
// open to any signed-in staff member, not just the uploader, since a
// Supervisor, Manager, or the General Manager reviewing someone else's
// submission needs to see the photo attached to it.
//
// Scan-to-Job (StaffIdGate.tsx / authService.ts's loginByStaffCode)
// deliberately never creates a Firebase Auth session — there's no
// request.auth at all for that login, on purpose (see that file's
// comment for why). So a photo taken by someone logged in with a Staff
// ID can never satisfy isSignedIn() here, no matter what this file says
// — this isn't a gap to close by loosening the rule (that would mean
// letting ANYONE, authenticated or not, write into any uploader's
// folder). PhotoCapture.tsx already knows this and skips the upload
// attempt entirely for that case (Cloudinary now, this bucket before),
// keeping the photo as a local data URL embedded in the submission
// instead — exactly like demo mode already does. Nothing to change here
// unless Scan-to-Job later gets a real Auth session behind it (e.g. a
// custom token minted server-side — see mintStaffCodeToken, which now
// does exactly that on a best-effort basis).

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    match /submissions/{uid}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn()
        && request.auth.uid == uid
        // Downscaled client-side before upload (see PhotoCapture.tsx) —
        // a typical photo lands well under 1MB. 10MB is headroom for a
        // slow/unusual capture, not an expected size.
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Photo evidence is meant to be permanent once attached to a
      // submission — nothing in this app currently needs to delete one,
      // so this stays closed rather than silently allowing it.
      allow delete: if false;
    }

    // Nothing else is served from this bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
