rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and `firebase init` once, pointed at this project)
//
// Covers every collection in the app's data model (see src/types.ts):
//   users        — accounts + roles
//   submissions  — checklist/work-order submissions
//   warnings     — supervisor-issued warnings
//   fieldReports — "something's broken" reports
//   trainings    — training module completion
//
// NOTE: as of this version, `users`, `submissions`, `warnings`, and
// `fieldReports` are all actually read/written from Firestore by the
// client (authService.ts/usersService.ts, submissionsService.ts,
// warningsService.ts, fieldReportsService.ts) — see useAppStore.ts.
// `trainings` is still pending that same migration and still lives in
// each browser's localStorage for now; its rules below are ready for
// whenever that happens, same as the other four were before this version.
//
// Staff ID logins (StaffIdGate.tsx) used to never establish a real
// Firebase Auth session at all, meaning isSignedIn() below (request.auth
// != null) was never true for that kind of session — every read/write
// gated by it, submissions included, failed with permission-denied. As of
// this version that's fixed on a best-effort basis: loginByStaffCode
// (authService.ts) now calls mintStaffCodeToken (functions/src/index.ts)
// to mint a real custom Auth token, server-side, for that same account's
// existing uid — but that Cloud Function has to actually be deployed
// (`firebase deploy --only functions`) for the upgrade to take effect. A
// Staff ID session on a project where it isn't deployed yet (or where the
// call fails for any other reason) still falls back to the old
// no-real-session behavior — same isSignedIn()-blocked limitation as
// before, not a regression, just not yet upgraded.
//
// Open self-signup is allowed: a new user may create their OWN users/{email}
// doc once, with a non-ADMIN role. Admin still controls role changes after that.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Change this if you use a different super-admin address than the
    // one baked into src/services/authService.ts — keep them in sync.
    // This ONE account is permanently an admin and can never be demoted,
    // deleted, or otherwise altered by anyone but itself — see isAdmin()
    // below for everyone else who holds the ADMIN role.
    function isSuperAdmin() {
      return isSignedIn() && email() == 'mpigome44@gmail.com';
    }

    // True for the bootstrap super-admin OR anyone an existing admin has
    // since promoted to the ADMIN role (see updateUserRole in
    // useAppStore.ts) — ADMIN is no longer locked to one hardcoded
    // account. Looks up the CALLER's own profile doc by their own email,
    // never the doc being written, so this can't be used to self-approve
    // a role change that isn't already true.
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        get(/databases/$(database)/documents/users/$(email())).data.role == 'ADMIN'
      );
    }

    function isOwnUserDoc(userId) {
      return isSignedIn() && userId == email();
    }

    function onlyChanged(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // ── users ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Public single-doc lookup, deliberately not gated on isSignedIn():
      // loginOrRegister() in authService.ts calls getDoc(users/{email})
      // BEFORE the person is authenticated, to check whether an invite
      // exists for that email at all. Without this exact rule, that first
      // read throws "Missing or insufficient permissions" on every login
      // attempt — it's not wrapped in try/catch client-side, so it
      // surfaces as an uncaught crash, not a friendly error message.
      // Listing the whole collection still requires sign-in.
      allow get: if true;
      allow list: if isSignedIn();

      // Open self-signup: a signed-in user creates THEIR OWN doc once
      // (right after createUserWithEmailAndPassword, when no invite
      // existed for their email). Cannot self-assign ADMIN. Cannot
      // create a doc for a different email than their own.
      allow create: if isOwnUserDoc(userId)
        && request.resource.data.email == email()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role != 'ADMIN'
        && request.resource.data.isActive == true;

      // First-login activation (invite path): a user may attach their own
      // uid to their own (pre-existing, admin-created) doc, optionally
      // correcting their name at the same time — but nothing else. Role,
      // isActive, site, and email changes are admin-only.
      allow update: if isOwnUserDoc(userId)
        && onlyChanged(['uid', 'firstName', 'lastName', 'name'])
        && resource.data.uid == null
        && request.resource.data.uid == request.auth.uid;

      // Full create/update access for any admin — including granting or
      // revoking the ADMIN role on someone else. The one exception: the
      // original bootstrap account can never be altered by anyone but
      // itself, so there's always at least one admin nobody else can
      // demote, delete, or lock out (accidentally or otherwise).
      allow create, update: if isAdmin()
        && (userId != 'mpigome44@gmail.com' || isSuperAdmin());

      allow delete: if isAdmin() && userId != 'mpigome44@gmail.com';
    }

    // ── staffCodes ───────────────────────────────────────────────────
    // Scan-to-Job login (StaffIdGate.tsx / authService.ts's
    // loginByStaffCode): a small public-read index, {CODE} -> { email },
    // so a Staff ID can be resolved to a users/{email} profile before the
    // person is authenticated — the same reason users/{userId} allows a
    // public `get` above. Staff ID alone is the credential (no PIN) —
    // only an admin can create/change/remove entries, so a code is never
    // chosen by whoever gets to a signup form first.
    match /staffCodes/{code} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── submissions ─────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';

      // Two distinct actions share this collection's update path — see
      // useAppStore.ts's addSignoffStamp/rejectSignoff/resubmitAfterRejection:
      //
      // 1. A reviewer (not the submitter) stamps a sign-off step or
      //    rejects a still-PENDING submission — changes meta (the stamp)
      //    and/or status/rejectionReason, never the submitted answers
      //    themselves (items is not in this list).
      // 2. The original submitter fixes and resubmits their OWN
      //    REJECTED submission in place — changes items/meta/score and
      //    flips status back to PENDING, clearing rejectionReason.
      allow update: if isSignedIn() && (
        (request.auth.uid != resource.data.userId
          && resource.data.status == 'PENDING'
          && onlyChanged(['meta', 'status', 'rejectionReason']))
        ||
        (request.auth.uid == resource.data.userId
          && resource.data.status == 'REJECTED'
          && request.resource.data.status == 'PENDING'
          && onlyChanged(['items', 'meta', 'score', 'status', 'rejectionReason']))
      );

      allow delete: if false;
    }

    // ── warnings ────────────────────────────────────────────────────
    match /warnings/{warningId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.supervisorId == request.auth.uid;

      allow update: if false;
      allow delete: if false;
    }

    // ── fieldReports ────────────────────────────────────────────────
    // "Something's broken" reports (ReportIssueButton.tsx) — a frontline
    // worker files one, a Supervisor/Manager acknowledges then resolves
    // it (FieldReportsTab.tsx / MyFieldReports.tsx). Same two-actor shape
    // as submissions' checkedBy/approvedBy stamps, just a flatter status
    // (OPEN -> ACKNOWLEDGED -> RESOLVED) instead of a named chain.
    match /fieldReports/{reportId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'OPEN';

      // A reviewer (not the filer) acknowledging or resolving — never
      // rewrites the original message/photo.
      allow update: if isSignedIn()
        && request.auth.uid != resource.data.userId
        && onlyChanged(['status', 'acknowledgedBy', 'acknowledgedAt', 'resolvedBy', 'resolvedAt', 'resolutionNote']);

      allow delete: if false;
    }

    // ── trainings (not yet used by the client — see note above) ───────
    match /trainings/{moduleId} {
      allow read: if isSignedIn();

      allow create, delete: if isAdmin();

      // Admin can edit anything; anyone signed in may mark themselves
      // complete (append their own uid to completedBy) but nothing else.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && onlyChanged(['completedBy'])
          && request.resource.data.completedBy.size() == resource.data.completedBy.size() + 1
          && request.resource.data.completedBy.toSet().difference(resource.data.completedBy.toSet()) == [request.auth.uid].toSet()
        );
    }
  }
}
