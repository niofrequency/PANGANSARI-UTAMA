rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and `firebase init` once, pointed at this project)
//
// Covers every collection in the app's data model (see src/types.ts):
//   users        — accounts + roles
//   submissions  — checklist/work-order submissions
//   warnings     — supervisor-issued warnings
//   fieldReports — "something's broken" reports
//   correctiveActions — CAPA-style assigned action items (two-step close)
//   trainings    — training module completion
//   messages     — in-app chat between two people
//   pushTokens   — devices that turned on chat notifications
//
// NOTE: as of this version, all five collections above are actually
// read/written from Firestore by the client (authService.ts/
// usersService.ts, submissionsService.ts, warningsService.ts,
// fieldReportsService.ts, trainingsService.ts) — see useAppStore.ts.
// Module content itself (trainings/{moduleId}'s name/description/etc.,
// as opposed to who's completed it) is still expected to be added
// directly in the Firebase Console — nothing in the client ever creates
// or deletes a module, hence create/delete staying isAdmin()-only below
// rather than open to any signed-in caller.
//
// Staff ID logins (StaffIdGate.tsx) used to never establish a real
// Firebase Auth session at all, meaning isSignedIn() below (request.auth
// != null) was never true for that kind of session — every read/write
// gated by it, submissions included, failed with permission-denied. As of
// this version that's fixed on a best-effort basis: loginByStaffCode
// (authService.ts) now calls mintStaffCodeToken (functions/src/index.ts)
// to mint a real custom Auth token, server-side, for that same account's
// existing uid — but that Cloud Function has to actually be deployed
// (`firebase deploy --only functions`) for the upgrade to take effect. A
// Staff ID session on a project where it isn't deployed yet (or where the
// call fails for any other reason) still falls back to the old
// no-real-session behavior — same isSignedIn()-blocked limitation as
// before, not a regression, just not yet upgraded.
//
// Open self-signup is allowed: a new user may create their OWN users/{email}
// doc once, with a non-ADMIN role. Admin still controls role changes after that.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Change this if you use a different super-admin address than the
    // one baked into src/services/authService.ts — keep them in sync.
    // This ONE account is permanently an admin and can never be demoted,
    // deleted, or otherwise altered by anyone but itself — see isAdmin()
    // below for everyone else who holds the ADMIN role.
    function isSuperAdmin() {
      return isSignedIn() && email() == 'mpigome44@gmail.com';
    }

    // True for the bootstrap super-admin OR anyone an existing admin has
    // since promoted to the ADMIN role (see updateUserRole in
    // useAppStore.ts) — ADMIN is no longer locked to one hardcoded
    // account. Looks up the CALLER's own profile doc by their own email,
    // never the doc being written, so this can't be used to self-approve
    // a role change that isn't already true.
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        get(/databases/$(database)/documents/users/$(email())).data.role == 'ADMIN'
      );
    }

    // Housekeeping / Food Safety / General Managers — can manage every
    // NON-admin account from the Manager Portal's Users tab (see
    // UserManagementPanel.tsx). They can never create, promote to,
    // edit, or delete an ADMIN account; only isAdmin() can.
    function isManager() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(email())).data.role in
          ['HOUSEKEEPING_MANAGER', 'FOOD_SAFETY_MANAGER', 'GENERAL_MANAGER'] &&
        get(/databases/$(database)/documents/users/$(email())).data.isActive != false;
    }

    function isOwnUserDoc(userId) {
      return isSignedIn() && userId == email();
    }

    function onlyChanged(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // ── users ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Public single-doc lookup, deliberately not gated on isSignedIn():
      // loginOrRegister() in authService.ts calls getDoc(users/{email})
      // BEFORE the person is authenticated, to check whether an invite
      // exists for that email at all. Without this exact rule, that first
      // read throws "Missing or insufficient permissions" on every login
      // attempt — it's not wrapped in try/catch client-side, so it
      // surfaces as an uncaught crash, not a friendly error message.
      // Listing the whole collection still requires sign-in.
      allow get: if true;
      allow list: if isSignedIn();

      // Open self-signup: a signed-in user creates THEIR OWN doc once
      // (right after createUserWithEmailAndPassword, when no invite
      // existed for their email). Cannot self-assign ADMIN. Cannot
      // create a doc for a different email than their own.
      allow create: if isOwnUserDoc(userId)
        && request.resource.data.email == email()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role != 'ADMIN'
        && request.resource.data.isActive == true;

      // First-login activation (invite path): a user may attach their own
      // uid to their own (pre-existing, admin-created) doc, optionally
      // correcting their name at the same time — but nothing else. Role,
      // isActive, site, and email changes are admin-only.
      allow update: if isOwnUserDoc(userId)
        && onlyChanged(['uid', 'firstName', 'lastName', 'name'])
        && resource.data.uid == null
        && request.resource.data.uid == request.auth.uid;

      // Full create/update access for any admin — including granting or
      // revoking the ADMIN role on someone else. The one exception: the
      // original bootstrap account can never be altered by anyone but
      // itself, so there's always at least one admin nobody else can
      // demote, delete, or lock out (accidentally or otherwise).
      allow create, update: if isAdmin()
        && (userId != 'mpigome44@gmail.com' || isSuperAdmin());

      allow delete: if isAdmin() && userId != 'mpigome44@gmail.com';

      // Managers: same as above for every non-ADMIN account.
      allow create: if isManager()
        && userId != 'mpigome44@gmail.com'
        && request.resource.data.role != 'ADMIN';
      allow update: if isManager()
        && userId != 'mpigome44@gmail.com'
        && resource.data.role != 'ADMIN'
        && request.resource.data.role != 'ADMIN';
      allow delete: if isManager()
        && userId != 'mpigome44@gmail.com'
        && resource.data.role != 'ADMIN';
    }

    // ── staffCodes ───────────────────────────────────────────────────
    // Scan-to-Job login (StaffIdGate.tsx / authService.ts's
    // loginByStaffCode): a small public-read index, {CODE} -> { email },
    // so a Staff ID can be resolved to a users/{email} profile before the
    // person is authenticated — the same reason users/{userId} allows a
    // public `get` above. Staff ID alone is the credential (no PIN) —
    // only an admin can create/change/remove entries, so a code is never
    // chosen by whoever gets to a signup form first.
    match /staffCodes/{code} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
      // Managers may hand out / change / remove Staff IDs for non-ADMIN
      // accounts only — never point a code at an ADMIN's email (that would
      // let them sign in as that admin via Scan-to-Job).
      allow create: if isManager()
        && get(/databases/$(database)/documents/users/$(request.resource.data.email)).data.role != 'ADMIN';
      allow update: if isManager()
        && get(/databases/$(database)/documents/users/$(resource.data.email)).data.role != 'ADMIN'
        && get(/databases/$(database)/documents/users/$(request.resource.data.email)).data.role != 'ADMIN';
      allow delete: if isManager()
        && get(/databases/$(database)/documents/users/$(resource.data.email)).data.role != 'ADMIN';
    }

    // ── submissions ─────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';

      // Three distinct actions share this collection's update path — see
      // useAppStore.ts's addSignoffStamp/rejectSignoff/resubmitAfterRejection/
      // deleteSubmission:
      //
      // 1. A reviewer (not the submitter) stamps a sign-off step or
      //    rejects a still-PENDING submission — changes meta (the stamp)
      //    and/or status/rejectionReason, never the submitted answers
      //    themselves (items is not in this list). A final stamp also
      //    clears wasApprovedBeforeEdit (see its comment in types.ts).
      // 2. The original submitter edits their OWN entry in place from any
      //    status — including one already APPROVED, not just REJECTED —
      //    changes items/meta/score and always flips status back to
      //    PENDING, clearing rejectionReason and setting
      //    wasApprovedBeforeEdit so a reviewer who already stamped this
      //    can tell the content changed since. Editing content a reviewer
      //    already stamped has to re-enter review; there's no path here
      //    that lets an edit keep a prior approval attached to it.
      // 3. The original submitter soft-deletes their OWN entry — sets
      //    deletedAt/deletedBy and nothing else, from the History tab's
      //    "type DELETE to confirm" fail-safe (ConfirmDeleteModal). Not a
      //    real delete (see `allow delete: if false` below and
      //    deletedAt's comment on Submission in types.ts) — status and
      //    every other field stay exactly as they were, so the record
      //    still reads as real history if it's ever needed again.
      allow update: if isSignedIn() && (
        (request.auth.uid != resource.data.userId
          && resource.data.status == 'PENDING'
          && onlyChanged(['meta', 'status', 'rejectionReason', 'wasApprovedBeforeEdit']))
        ||
        (request.auth.uid == resource.data.userId
          && request.resource.data.status == 'PENDING'
          && onlyChanged(['items', 'meta', 'score', 'status', 'rejectionReason', 'wasApprovedBeforeEdit']))
        ||
        (request.auth.uid == resource.data.userId
          && onlyChanged(['deletedAt', 'deletedBy']))
      );

      // Real deletes never happen client-side — see the soft-delete
      // branch of allow update above.
      allow delete: if false;
    }

    // ── warnings ────────────────────────────────────────────────────
    match /warnings/{warningId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.supervisorId == request.auth.uid;

      allow update: if false;
      allow delete: if false;
    }

    // ── fieldReports ────────────────────────────────────────────────
    // "Something's broken" reports (ReportIssueButton.tsx) — a frontline
    // worker files one, a Supervisor/Manager acknowledges then resolves
    // it (FieldReportsTab.tsx / MyFieldReports.tsx). Same two-actor shape
    // as submissions' checkedBy/approvedBy stamps, just a flatter status
    // (OPEN -> ACKNOWLEDGED -> RESOLVED) instead of a named chain.
    match /fieldReports/{reportId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'OPEN';

      // A reviewer (not the filer) acknowledging or resolving — never
      // rewrites the original message/photo.
      allow update: if isSignedIn()
        && request.auth.uid != resource.data.userId
        && onlyChanged(['status', 'acknowledgedBy', 'acknowledgedAt', 'resolvedBy', 'resolvedAt', 'resolutionNote']);

      allow delete: if false;
    }

    // ── correctiveActions ───────────────────────────────────────────
    // CAPA-style assigned action items (comment/action/assignedTo/
    // dueDate) — see types.ts's CorrectiveAction for the full shape.
    // Who may create one, and who they may assign it to, is enforced
    // client-side (same trust level this app already gives siteId/
    // department on submissions and fieldReports, neither of which is
    // re-verified against the caller's own profile here either) — this
    // rule only verifies the caller is who they claim to be for whichever
    // one of the three transitions below they're making.
    match /correctiveActions/{actionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == 'OPEN';

      // Three distinct actions share this collection's update path — see
      // useAppStore.ts's markCorrectiveActionDone/verifyCorrectiveAction/
      // reopenCorrectiveAction:
      //
      // 1. The ASSIGNEE marks it done (OPEN -> DONE) with a completion
      //    note. Only them, and only while still OPEN.
      // 2. The CREATOR (always the verifier) closes it for good
      //    (DONE -> VERIFIED) once satisfied.
      // 3. The CREATOR instead sends it back (DONE -> OPEN) with a note
      //    of their own if the work isn't actually done — same
      //    reopen-for-another-try shape as a rejected submission.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.assignedToId
          && resource.data.status == 'OPEN'
          && request.resource.data.status == 'DONE'
          && onlyChanged(['status', 'completedAt', 'completionNote']))
        ||
        (request.auth.uid == resource.data.createdById
          && resource.data.status == 'DONE'
          && request.resource.data.status == 'VERIFIED'
          && onlyChanged(['status', 'verifiedAt']))
        ||
        (request.auth.uid == resource.data.createdById
          && resource.data.status == 'DONE'
          && request.resource.data.status == 'OPEN'
          && onlyChanged(['status', 'reopenedAt', 'reopenedNote']))
      );

      allow delete: if false;
    }

    // ── messages ────────────────────────────────────────────────────
    // In-app chat (components/Chat/ChatTab.tsx) — one doc per message
    // between exactly two people. Mirrors src/lib/chatPolicy.ts:
    //   Admin <-> everyone; Manager <-> Supervisor, Manager; Supervisor
    //   <-> Supervisor and frontline staff; frontline staff <-> Supervisor
    //   only. Same department, except the General Manager who spans both.
    //   Food Safety Technicians only with a Supervisor whose home site is
    //   one of the Technician's own sites (their location supervisor).
    function chatIsManager(r) {
      return r in ['HOUSEKEEPING_MANAGER', 'FOOD_SAFETY_MANAGER', 'GENERAL_MANAGER'];
    }
    function chatIsSupervisor(r) {
      return r in ['HOUSEKEEPING_SUPERVISOR', 'FOOD_SAFETY_SUPERVISOR', 'HOUSEKEEPING_LEADHAND', 'FOOD_SAFETY_LEADHAND'];
    }
    function chatIsFrontline(r) {
      return r in ['HOUSEKEEPER', 'HOUSEKEEPING_LAUNDRY', 'HOUSEKEEPING_JANITOR', 'FOOD_SAFETY_TECHNICIAN'];
    }
    function chatDept(r) {
      return r == 'GENERAL_MANAGER' ? 'ALL'
        : (r in ['HOUSEKEEPER', 'HOUSEKEEPING_LAUNDRY', 'HOUSEKEEPING_JANITOR', 'HOUSEKEEPING_LEADHAND', 'HOUSEKEEPING_SUPERVISOR', 'HOUSEKEEPING_MANAGER'] ? 'HK' : 'FS');
    }
    function chatSameDept(a, b) {
      return chatDept(a) == 'ALL' || chatDept(b) == 'ALL' || chatDept(a) == chatDept(b);
    }
    function chatTechSites(t) {
      return t.get('assignedSites', null) is list ? t.assignedSites.concat([t.site]) : [t.site];
    }
    // a and b are the two users' profile docs (data maps).
    function chatTechSiteOk(a, b) {
      return (a.role == 'FOOD_SAFETY_TECHNICIAN' && chatIsSupervisor(b.role)) ? b.site in chatTechSites(a)
        : ((b.role == 'FOOD_SAFETY_TECHNICIAN' && chatIsSupervisor(a.role)) ? a.site in chatTechSites(b) : true);
    }
    function canChatUsers(a, b) {
      return a.role == 'ADMIN' || b.role == 'ADMIN'
        || (canChat(a.role, b.role) && chatTechSiteOk(a, b));
    }
    function canChat(a, b) {
      return (chatIsManager(a) && chatIsManager(b))
        || (chatSameDept(a, b) && (
          (chatIsManager(a) && chatIsSupervisor(b))
          || (chatIsSupervisor(a) && chatIsManager(b))
          || (chatIsSupervisor(a) && chatIsSupervisor(b))
          || (chatIsSupervisor(a) && chatIsFrontline(b))
          || (chatIsFrontline(a) && chatIsSupervisor(b))
        ));
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.fromEmail == email()
        && request.resource.data.participants == [request.auth.uid, request.resource.data.toId]
        && request.resource.data.read == false
        // sentAt (server time, used for the 15-minute edit window) can't be
        // faked; it may be missing only from not-yet-updated app versions.
        && (!('sentAt' in request.resource.data) || request.resource.data.sentAt == request.time)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && get(/databases/$(database)/documents/users/$(email())).data.isActive != false
        && get(/databases/$(database)/documents/users/$(request.resource.data.toEmail)).data.uid == request.resource.data.toId
        && canChatUsers(
          get(/databases/$(database)/documents/users/$(email())).data,
          get(/databases/$(database)/documents/users/$(request.resource.data.toEmail)).data
        );

      allow update: if isSignedIn() && (
        // 1. The recipient marks it read.
        (request.auth.uid == resource.data.toId
          && onlyChanged(['read'])
          && request.resource.data.read == true)
        ||
        // 2. The sender edits the text of a message they haven't deleted,
        //    within 15 minutes of sending (server time).
        (request.auth.uid == resource.data.fromId
          && resource.data.get('deleted', false) != true
          && resource.data.get('sentAt', null) != null
          && request.time < resource.data.sentAt + duration.value(15, 'm')
          && onlyChanged(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000)
        ||
        // 3. The sender deletes it for everyone — text blanked, doc kept so
        //    the thread shows "This message was deleted".
        (request.auth.uid == resource.data.fromId
          && onlyChanged(['deleted', 'text', 'deletedAt'])
          && request.resource.data.deleted == true
          && request.resource.data.text == '')
        ||
        // 4. Either participant hides it for themselves only ("Delete for
        //    me" / "Clear chat") — may only ADD their own uid to hiddenFor.
        (request.auth.uid in resource.data.participants
          && onlyChanged(['hiddenFor'])
          && request.resource.data.hiddenFor.toSet().hasAll(resource.data.get('hiddenFor', []).toSet())
          && request.resource.data.hiddenFor.toSet().difference(resource.data.get('hiddenFor', []).toSet()) == [request.auth.uid].toSet())
      );

      allow delete: if false;
    }

    // ── pushTokens ──────────────────────────────────────────────────
    // One doc per device that turned on chat notifications, keyed by its
    // FCM token (src/lib/pushNotifications.ts). Only the notifyChatMessage
    // Cloud Function reads them (Admin SDK, bypasses rules). A device that
    // switches accounts simply overwrites the doc with the new uid.
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── trainings ───────────────────────────────────────────────────
    match /trainings/{moduleId} {
      allow read: if isSignedIn();

      allow create, delete: if isAdmin();

      // Admin can edit anything; anyone signed in may mark themselves
      // complete (append their own uid to completedBy) but nothing else.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && onlyChanged(['completedBy'])
          && request.resource.data.completedBy.size() == resource.data.completedBy.size() + 1
          && request.resource.data.completedBy.toSet().difference(resource.data.completedBy.toSet()) == [request.auth.uid].toSet()
        );
    }
  }
}
